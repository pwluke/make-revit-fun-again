<Window
    x:Class="BIM_Boom.Views.BIM_BoomView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:viewModel="clr-namespace:BIM_Boom.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewModel:BIM_BoomViewModel}"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    Title="BIM-Boom Voxelizer"
    Height="520"
    Width="420">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <TextBlock Grid.Row="0" Text="Revit → IFC → Voxelizer" FontSize="20" FontWeight="Bold" Margin="0,0,0,12"/>

        <!-- Export Button -->
        <Button Grid.Row="1" Content="📦 Export Selection &amp; Voxelize" Command="{Binding ExportAndVoxelizeCommand}"
                Height="36" FontSize="14" Margin="0,0,0,12"/>

        <!-- Parameters -->
        <GroupBox Grid.Row="2" Header="Voxel Parameters" Margin="0,0,0,12" Padding="8">
            <StackPanel>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Cell Size (ft):" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0.1" Maximum="10" Value="{Binding CellSize}" 
                            TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding CellSize, StringFormat=F1}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Threshold (ft):" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0.05" Maximum="5" Value="{Binding DistanceThreshold}" 
                            TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding DistanceThreshold, StringFormat=F2}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Max Voxels:" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="1000" Maximum="50000" Value="{Binding MaxVoxels}" 
                            TickFrequency="1000" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding MaxVoxels}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Recompute Button -->
        <Button Grid.Row="3" Content="🔄 Recompute Preview" Command="{Binding RecomputePreviewCommand}"
                IsEnabled="{Binding IsRecomputeEnabled}" Height="32" Margin="0,0,0,12"/>

        <!-- Voxel Count -->
        <TextBlock Grid.Row="4" Margin="0,0,0,8">
            <Run Text="Voxel Count: "/><Run Text="{Binding VoxelCount, Mode=OneWay}"/>
        </TextBlock>

        <!-- Stream Section -->
        <GroupBox Grid.Row="5" Header="Web Streaming (InstantDB)" Margin="0,0,0,12" Padding="8">
            <StackPanel>
                <Grid Margin="0,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="App ID:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding AppId, UpdateSourceTrigger=PropertyChanged}" FontSize="10"/>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Token:" VerticalAlignment="Center"/>
                    <PasswordBox Grid.Column="1" FontSize="10"
                                 x:Name="AdminTokenBox"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Stream Button -->
        <Button Grid.Row="6" Content="🌐 Stream to Web App" Command="{Binding StreamToWebAppCommand}"
                IsEnabled="{Binding IsStreamEnabled}" Height="36" FontSize="14" Margin="0,0,0,12"/>

        <!-- Status -->
        <Border Grid.Row="8" Background="#F0F0F0" CornerRadius="4" Padding="8">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11"/>
        </Border>
    </Grid>
</Window>