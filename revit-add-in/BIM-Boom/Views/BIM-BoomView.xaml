<Window
    x:Class="BIM_Boom.Views.BIM_BoomView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:viewModel="clr-namespace:BIM_Boom.ViewModels"
    mc:Ignorable="d"
    d:DataContext="{d:DesignInstance viewModel:BIM_BoomViewModel}"
    ResizeMode="CanResizeWithGrip"
    WindowStartupLocation="CenterScreen"
    Title="BIM-Boom — export model for the game"
    Height="560"
    Width="460">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Title -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Revit → game JSON" FontSize="20" FontWeight="Bold"/>
            <TextBlock TextWrapping="Wrap" Foreground="#555" FontSize="11" Margin="0,4,0,0"
                       Text="Voxelizes the model layer by layer and writes the ten *_voxels.json files the web game loads from its public/ folder. Select elements first to export only those; otherwise the whole model goes."/>
        </StackPanel>

        <!-- The button -->
        <Button Grid.Row="1" Content="📦 Export model for the game"
                Command="{Binding ExportGameJsonCommand}"
                Height="40" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/>

        <!-- Output folder -->
        <GroupBox Grid.Row="2" Header="Output folder" Margin="0,0,0,12" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox Text="{Binding OutputFolder}" VerticalAlignment="Center"
                         VerticalContentAlignment="Center" Height="26" Padding="4,0"/>
                <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseOutputFolderCommand}"
                        Height="26" Padding="10,0" Margin="6,0,0,0"/>
            </Grid>
        </GroupBox>

        <!-- Parameters -->
        <GroupBox Grid.Row="3" Header="Voxel Parameters" Margin="0,0,0,12" Padding="8">
            <StackPanel>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Cell Size XY (ft):" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0.3" Maximum="6" Value="{Binding CellSize}"
                            TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding CellSize, StringFormat=F1}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Layer Height Z (ft):" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0.3" Maximum="6" Value="{Binding LayerHeight}"
                            TickFrequency="0.1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding LayerHeight, StringFormat=F1}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Text="Keep Layer Height = Cell Size for isotropic voxels."
                           Foreground="#777" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Cutout Tolerance (× cell):" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="0.3" Maximum="2" Value="{Binding CutoutTolerance}"
                            TickFrequency="0.05" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding CutoutTolerance, StringFormat=F2}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock Text="Below ~0.7 the shell develops pinholes. Default 0.5 × cell size, independently adjustable."
                           Foreground="#777" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,4"/>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="70"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Max points per layer:" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Minimum="10000" Maximum="400000" Value="{Binding MaxVoxels}"
                            TickFrequency="10000" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="{Binding MaxVoxels}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                </Grid>
            </StackPanel>
        </GroupBox>

        <!-- Point count -->
        <TextBlock Grid.Row="4" Margin="0,0,0,8">
            <Run Text="Points exported: "/><Run Text="{Binding VoxelCount, Mode=OneWay}"/>
        </TextBlock>

        <!-- Voxelize Selection (cutout preview) -->
        <Button Grid.Row="5" Content="🔍 Voxelize Selection (preview)"
                Command="{Binding VoxelizeSelectionCommand}"
                Height="32" Margin="0,0,0,8"
                ToolTip="Cutout the current selection against the cached project grid and show DC3D preview. Does not write files."/>

        <!-- Status -->
        <Border Grid.Row="8" Background="#F0F0F0" CornerRadius="4" Padding="8">
            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="11"/>
        </Border>
    </Grid>
</Window>
